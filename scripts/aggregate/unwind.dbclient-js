// Active: 1774550346794@@eenzofelipe67527_db_user@null@aula
        db("aula").collection("frutas").aggregate([
            {
                $lookup: {
                    from: "personagens",
                    localField: "_id",
                    foreignField: "frutas_ids",
                    as: "personagens"
                }
            },
            {
                unwind: "$personagens"
            }
        ])