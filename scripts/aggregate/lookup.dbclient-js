// Active: 1774550346794@@eenzofelipe67527_db_user@null@aula
db("aula").collection("personagens").aggregate([
    {
        $match: {
            origem_id: { $exists: true},
            frutas_id: {
                $exists: true,
                $not: { $size: 0},
            },
        },
    },
    {
        $lookup: {
            from: "origens",
            localFields: "origem_id",
            foreignField: "_id",
            as: "origem",
        },
    },
    {
        $lookup: {
            from: "frutas",
            localFields: "frutas_id",
            foreignField: "_id",
            as: "frutas",
        },
    },
    {
        $unset: ["origem_id", "frutas_id"]
    }
])