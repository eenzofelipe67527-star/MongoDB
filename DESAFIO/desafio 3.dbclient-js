db("sample_mflix").collection("movies").aggregate([
    {
        $group: {
            _id: "$genres",
            avgRating: { $avg: "$imdb.rating" },
             total: { $sum: 1 },
             movies: { $push: "$$ROOT" },
        }
    }
])